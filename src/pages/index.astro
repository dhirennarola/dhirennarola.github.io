---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Testimonial from '../components/Testimonial.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import CaseRow from '../components/CaseRow.astro';
import portrait from '../assets/dhiren-narola.png';
import {
  career,
  recommendations,
  contact,
  numbers,
  continentCount,
  odooStoreApps,
} from '../data/facts';
import delivery from '../data/delivery.json';
import { faqSchema, professionalServiceSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const arrow = `<svg class="i-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>`;

const insights = (await getCollection('insights'))
  .filter((i) => !i.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featuredWork = work.slice(0, 3);

/* One row per buying situation. The visitor finds their own problem in the
   first column, so nobody has to read the whole page to find the right service. */
const paths = [
  {
    situation: 'You are starting on Odoo, or replacing a patchwork of tools.',
    service: 'ERP implementation',
    what: 'Requirements, architecture, custom modules, data migration, training and go-live, all led by one person.',
    first: 'A discovery call, then a fixed written proposal.',
    href: '/services/erp-implementation/',
  },
  {
    situation: 'Your Odoo project is stuck, slow or failing.',
    service: 'ERP rescue',
    what: 'An independent look at what works, what does not and what it will take to fix it.',
    first: 'A written assessment within days, with a fixed quote.',
    href: '/services/erp-rescue/',
  },
  {
    situation: 'You must pass ZATCA, or connect Odoo to other systems.',
    service: 'Integrations & e-invoicing',
    what: 'ZATCA Phase 2, WooCommerce, WhatsApp, payment gateways and legacy bridges, built with retries and logs.',
    first: 'A map of every system and where data can break.',
    href: '/services/integrations-einvoicing/',
  },
  {
    situation: 'Your team still retypes documents and answers the same questions.',
    service: 'AI + Odoo',
    what: 'Document-to-record automation, WhatsApp self-service and agents that prepare work for a person to approve.',
    first: 'Find the two or three tasks worth automating.',
    href: '/services/ai-odoo/',
  },
  {
    situation: 'You are an Odoo partner and need senior delivery capacity.',
    service: 'Dedicated team',
    what: 'Architecture and development under your brand, from overflow work to a long-term team.',
    first: 'A short call about scope and how your team works.',
    href: '/services/dedicated-team/',
  },
];

/* What usually goes wrong in each industry, and the project that proves it. */
const industryRows = [
  {
    name: 'Automotive & Gulf compliance',
    href: '/industries/automotive-ksa/',
    hurts: ['ZATCA Phase 2 deadlines with real penalties', 'Saudi payroll (GOSI, end of service) done by hand', 'Branches that never reconcile at head office'],
    proof: { label: '300+ staff automotive group, KSA', href: '/work/ksa-automotive-erp/' },
  },
  {
    name: 'Manufacturing & pharma',
    href: '/industries/manufacturing/',
    hurts: ['Batch traceability kept in binders and memory', 'Production, accounting and quality in separate systems', 'No clear view of what production really costs'],
    proof: { label: '225-employee pharma producer, India', href: '/work/pharma-manufacturing-erp/' },
  },
  {
    name: 'Facility & field service',
    href: '/industries/facility-management/',
    hurts: ['Missed visits that breach subscription SLAs', 'Every customer request needs a phone call', 'No live view of technicians in the field'],
    proof: { label: 'Elevator maintenance, KSA', href: '/work/elevator-maintenance-automation/' },
  },
  {
    name: 'IT services, SaaS & telecom',
    hurts: ['Hour packages tracked in spreadsheets', 'Clients emailing for every status update', 'Billing that eats into billable time'],
    proof: { label: 'IT services billing, US', href: '/work/it-services-billing/' },
  },
  {
    name: 'Retail & jewellery',
    hurts: ['Catalogues that flatten product attributes', 'POS and back office disagreeing on stock', 'Jobwork charges counted by hand'],
    proof: { label: 'Caratiro Jewels on Odoo 19, India', href: '/work/jewellery-sales-tags/' },
  },
];

const regions = ['Middle East & Africa', 'Europe', 'Americas', 'Asia-Pacific'].map((name) => ({
  name,
  countries: delivery.countries.filter((c) => c.region === name),
}));

const steps = [
  {
    title: 'Discovery & architecture',
    body: 'Your processes first, the software second. Requirements, gap analysis and a signed-off design, so it is built right once.',
  },
  {
    title: 'Build in short sprints',
    body: 'Working demos every sprint and written updates you never have to chase.',
  },
  {
    title: 'Migration & go-live',
    body: 'Data migration, user testing, training and documentation. A planned cutover, not a leap.',
  },
  {
    title: 'Support',
    body: `Support from the person who designed your system, with replies within ${contact.responseTime}.`,
  },
];

const faqs = [
  {
    q: 'Do you handle the full implementation yourself?',
    a: 'Yes — one accountable lead from requirements to go-live. I architect the solution, build or direct the custom development, run data migration and UAT, and train your team. For larger scopes I bring in vetted developers under my direction, but ownership never fragments.',
  },
  {
    q: 'We already have a failed or stalled Odoo project. Can it be saved?',
    a: 'Usually, yes — and usually more of it is salvageable than the frustrated team expects. I start with a rapid independent assessment (days, not weeks): what works, what doesn’t, and a written recovery plan with a fixed quote before any remediation begins. See <a href="/services/erp-rescue/">ERP Rescue</a>.',
  },
  {
    q: 'What does an engagement cost?',
    a: 'Typical engagements start at $2,000 USD. Full implementations are quoted per scope after a discovery call — always as a written, fixed proposal, never open-ended billing. You’ll know the number before we start.',
  },
  {
    q: 'Where does AI fit into an Odoo project?',
    a: 'Where it pays for itself: WhatsApp self-service flows, document-to-record automation, and workflow agents that prepare repetitive work for human approval. I also use AI-driven development workflows internally, which measurably raised my team’s delivery productivity by ~30%. I’ll tell you honestly where AI is not worth your money — see <a href="/services/ai-odoo/">AI + Odoo</a>.',
  },
  {
    q: 'You’re in India — how does remote delivery work across time zones?',
    a: 'All 22 implementations were delivered remotely across 13 countries — North America, GCC, Europe, Africa, and Asia-Pacific. Structured sprints, proactive written updates, and overlap hours matched to your timezone. I reply within 8 business hours, usually much faster.',
  },
];

const featured = recommendations[0];
const moreQuotes = recommendations.slice(1, 3);

const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const jsonLd = [professionalServiceSchema(), faqSchema(faqs)];
---

<Base
  title="Dhiren Narola — Odoo Architect & AI Automation Engineer"
  description="Odoo 18 certified architect with 22 ERP implementations across 13 countries: Odoo implementation, ERP rescue, ZATCA e-invoicing and AI automation."
  path="/"
  jsonLd={jsonLd}
  navDark
>
  <!-- ============ HERO (logo navy, like the visiting card) ============ -->
  <section class="hero hero--brand on-dark home-hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>I lead Odoo projects myself, from the first workshop to go-live<span class="brand-dot">.</span></h1>
          <p class="hero-lede">
            I’m Dhiren Narola, an independent Odoo architect. Companies in the
            Gulf, Europe, the US and Australia bring me in to implement Odoo,
            rescue projects that have stalled, and add AI where it saves real
            hours. You deal with me throughout, not with a junior team.
          </p>
          <div class="hero-ctas">
            <a href="/contact/" class="btn btn--primary btn--lg">
              Book a discovery call <span class="arr" aria-hidden="true" set:html={arrow} />
            </a>
            <a href="/work/" class="btn btn--outline btn--lg">See case studies</a>
          </div>
          <ul class="hero-facts">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="m9 14.5-1.5 7.5L12 19.5l4.5 2.5-1.5-7.5"/><path d="m9.5 9 1.8 1.8 3.2-3.3"/></svg>
              <span><strong>Odoo 18 certified</strong> · functional certification by Odoo S.A.</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17.5 14v7M14 17.5h7"/></svg>
              <span><strong>{odooStoreApps.length} apps</strong> published on the <a href={contact.odooApps} target="_blank" rel="noopener">Odoo App Store</a></span>
            </li>
            <li>
              <span class="dot" aria-hidden="true"></span>
              <span><strong>Now building</strong> an end-to-end Odoo ERP for {career.currentEngagement.descriptor}</span>
            </li>
          </ul>
        </div>

        <figure class="hero-portrait">
          <Picture
            src={portrait}
            formats={['avif', 'webp']}
            alt="Dhiren Narola, Odoo architect"
            width={640}
            widths={[320, 480, 640]}
            sizes="(max-width: 959px) min(300px, 70vw), 340px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>

      <dl class="ledger">
        <div><dt class="stat-lbl">Implementations live</dt><dd class="stat-num">{numbers.implementations}</dd></div>
        <div><dt class="stat-lbl">Countries, {continentCount} continents</dt><dd class="stat-num">{numbers.countries}</dd></div>
        <div><dt class="stat-lbl">Failed go-lives</dt><dd class="stat-num">{numbers.failedGoLives}</dd></div>
        <div><dt class="stat-lbl">Odoo versions worked on</dt><dd class="stat-num">11 to 20</dd></div>
      </dl>
    </div>
  </section>

  <!-- ============ STARTING POINTS ============ -->
  <section class="section section--l" id="services">
    <div class="container">
      <SectionHeader
        eyebrow="Services"
        title="Where are you starting from?"
        desc="Each situation needs a different first step. Find yours and see what happens next."
      />
      <div class="paths">
        <div class="paths-head" aria-hidden="true">
          <span class="label">Your situation</span>
          <span class="label">What I do</span>
          <span class="label">First step</span>
        </div>
        <ul class="paths-list">
          {paths.map((p) => (
            <li>
              <a href={p.href} class="path">
                <span class="path-situation">{p.situation}</span>
                <span class="path-what">
                  <span class="path-service">{p.service}</span>
                  {p.what}
                </span>
                <span class="path-first"><span class="path-first-label">First step: </span>{p.first}</span>
                <span class="path-go" aria-hidden="true" set:html={arrow} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ CASE STUDIES ============ -->
  <section class="section section--l section--subtle" id="work">
    <div class="container">
      <SectionHeader
        eyebrow="Case studies"
        title="Selected projects, from the problem to the measured result"
        desc="Client names stay private. The problem, the decisions and the numbers don’t."
      />
      <ol class="cases">
        {featuredWork.map((w, i) => <CaseRow entry={w} index={i} />)}
      </ol>
      <p class="more after-label"><a href="/work/" class="link-arr">All {work.length} case studies <span class="arr" aria-hidden="true" set:html={arrow} /></a></p>
    </div>
  </section>

  <!-- ============ GLOBAL DELIVERY (navy band with the map) ============ -->
  <section class="section section--l section--dark on-dark global" id="global">
    <div class="container">
      <div class="global-head">
        <div>
          <span class="kicker">Global delivery</span>
          <h2>Delivered remotely in {delivery.countries.length} countries</h2>
        </div>
        <p>
          From India I share a full working day with the Gulf, the morning in
          Europe, the afternoon in Australia and New Zealand, and the early
          morning in the US. Written updates arrive before you need to ask.
        </p>
      </div>
      <div class="global-body">
      <figure class="map">
        <img
          src="/assets/world-delivery.svg"
          alt={`World map with the ${delivery.countries.length} delivery countries filled in: ${delivery.countries.map((c) => c.name).join(', ')}`}
          width="1000"
          height="470"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="regions">
        {regions.map((r) => (
          <div class="region">
            <h3 class="label">{r.name}</h3>
            <ul>
              {r.countries.map((c) => (
                <li>
                  <span class="c-name">{c.name}</span>
                  {c.note && <span class="c-note">{c.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      </div>
    </div>
  </section>

  <!-- ============ INDUSTRIES ============ -->
  <section class="section section--l" id="industries">
    <div class="container">
      <SectionHeader
        eyebrow="Industries"
        title="What usually goes wrong, by industry"
        desc="Each industry has its own rules and its own ways to fail. These are the ones I have taken live."
      />
      <table class="ind-table">
        <thead>
          <tr>
            <th scope="col" class="label">Industry</th>
            <th scope="col" class="label">What usually hurts</th>
            <th scope="col" class="label">Delivered proof</th>
          </tr>
        </thead>
        <tbody>
          {industryRows.map((r) => (
            <tr>
              <th scope="row" class="ind-name">
                {r.href ? <a href={r.href}>{r.name}</a> : r.name}
              </th>
              <td>
                <ul class="ind-hurts">
                  {r.hurts.map((h) => <li>{h}</li>)}
                </ul>
              </td>
              <td>
                <a href={r.proof.href} class="link-arr ind-proof">{r.proof.label} <span class="arr" aria-hidden="true" set:html={arrow} /></a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section section--l section--subtle" id="process">
    <div class="container">
      <SectionHeader
        eyebrow="Process"
        title="How a project runs"
        desc="You always know what is happening, what comes next and who is responsible."
      />
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="no" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ REFERENCES ============ -->
  <section class="section section--l" id="proof">
    <div class="container">
      <SectionHeader
        eyebrow="References"
        title="What clients and colleagues say"
        desc="LinkedIn recommendations, quoted word for word. Each one links to the original."
      />
      <div class="after-label refs">
        <Testimonial {...featured} featured />
        <div class="refs-more">
          {moreQuotes.map((q) => <Testimonial {...q} />)}
        </div>
        <p class="refs-all"><a href="/about/#testimonials" class="link-arr">Read all four recommendations <span class="arr" aria-hidden="true" set:html={arrow} /></a></p>
      </div>

      <div class="apps">
        <div class="apps-head">
          <span class="kicker">Published apps</span>
          <h3>My apps on the Odoo App Store</h3>
          <a href={contact.odooApps} target="_blank" rel="noopener" class="link-arr">See them on apps.odoo.com <span class="arr" aria-hidden="true" set:html={arrow} /></a>
        </div>
        <ul class="apps-list">
          {odooStoreApps.map((a) => (
            <li>
              <span class="app-name">{a.name}</span>
              <span class="app-desc">{a.desc}</span>
              <span class="label app-ver">{a.version}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ INSIGHTS ============ -->
  <section class="section section--l section--subtle" id="insights">
    <div class="container">
      <SectionHeader eyebrow="Insights" title="Notes from real Odoo projects" />
      <ul class="notes">
        {insights.map((post) => (
          <li>
            <a href={`/insights/${post.id}/`} class="note-link">
              <span class="label note-meta">
                <time datetime={post.data.publishDate.toISOString()}>{dateFmt.format(post.data.publishDate)}</time>
                · {post.data.readingTime} read
              </span>
              <span class="note-title">{post.data.title}</span>
              <span class="note-desc">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/insights/" class="link-arr">All insights <span class="arr" aria-hidden="true" set:html={arrow} /></a></p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section section--l" id="faq">
    <div class="container">
      <SectionHeader eyebrow="FAQ" title="Common questions" />
      <div class="after-label">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---- Hero ---- */
  .home-hero {
    padding-top: calc(var(--nav-h) + clamp(3rem, 7vw, 5.5rem));
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .home-hero h1 {
    font-size: clamp(2.3rem, 1.5rem + 3vw, 3.75rem);
    max-width: 19ch;
    margin-bottom: var(--s-5);
  }

  .hero-grid {
    align-items: center;
  }

  .hero-facts {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: var(--s-4) 0 0;
    border-top: 1px solid var(--navy-line);
    display: grid;
    gap: var(--s-3);
    font-size: var(--text-sm);
    max-width: 40rem;
  }

  .hero-facts li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin: 0;
    color: var(--td-soft);
  }

  .hero-facts a {
    color: var(--td);
    text-decoration: underline;
    text-decoration-color: var(--navy-line);
    text-underline-offset: 3px;
  }

  .hero-facts a:hover {
    color: #fff;
  }

  .hero-facts svg {
    flex: none;
    margin-top: 2px;
    color: var(--accent-ondark);
  }

  .hero-facts .dot {
    margin: 0.5em 5.5px 0;
  }

  .hero-portrait {
    margin: 0;
    width: 100%;
    max-width: 340px;
    justify-self: end;
  }

  @media (max-width: 959px) {
    .hero-portrait {
      justify-self: start;
      max-width: 300px;
    }
  }

  .hero-portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius);
    background: var(--navy-850);
  }

  .home-hero .ledger {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  /* ---- Starting points ---- */
  .paths-head {
    display: none;
  }

  .paths-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .paths-list li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .path {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5) 0;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .path-first-label {
    font-weight: 600;
    color: var(--ink-strong);
  }

  @media (min-width: 900px) {
    .paths-head,
    .path {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 4.6fr) minmax(0, 3.4fr) 2rem;
      gap: var(--s-5);
      align-items: start;
    }
    .paths-head {
      padding-bottom: var(--s-3);
    }
    .paths-head .label {
      margin: 0;
    }
    .path-first-label {
      display: none;
    }
  }

  .path-situation {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.25;
    color: var(--ink-strong);
    text-wrap: balance;
    transition: color var(--t-fast) ease;
  }

  .path-service {
    display: block;
    font-weight: 620;
    color: var(--ink-strong);
    margin-bottom: 0.2rem;
  }

  .path-what,
  .path-first {
    display: block;
  }

  .path-go {
    display: none;
    color: var(--ink-faint);
    padding-top: 0.45rem;
    justify-self: end;
    transition: transform var(--t-med) var(--ease-out), color var(--t-fast) ease;
  }

  @media (min-width: 900px) {
    .path-go {
      display: block;
    }
  }

  .path:hover .path-situation,
  .path:hover .path-go {
    color: var(--accent-strong);
  }

  .path:hover .path-go {
    transform: translateX(3px);
  }

  /* ---- Case studies ---- */
  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .more {
    margin: var(--s-6) 0 0;
  }

  /* ---- Global delivery ---- */
  .global-head {
    display: grid;
    gap: var(--s-4) var(--s-8);
    align-items: end;
    margin-bottom: var(--s-7);
  }

  @media (min-width: 900px) {
    .global-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .global-head h2 {
    margin: 0;
    max-width: 16ch;
  }

  .global-head p {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-lg);
  }

  .map {
    margin: 0;
  }

  .map img {
    width: 100%;
    height: auto;
    aspect-ratio: 1000 / 470;
  }

  .global-body {
    display: grid;
    gap: var(--s-7);
    align-items: start;
  }

  .map {
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
  }

  .regions {
    display: grid;
    gap: var(--s-6) var(--s-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--navy-line);
    padding-top: var(--s-4);
  }

  @media (min-width: 1024px) {
    .regions {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .region h3 {
    margin: 0 0 var(--s-3);
  }

  .region ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .region li {
    margin: 0;
    display: grid;
    gap: 0.1rem;
    font-size: var(--text-sm);
  }

