---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import CaseRow from '../../components/CaseRow.astro';
import { getCollection } from 'astro:content';
import { breadcrumbs } from '../../data/schema';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Work — Odoo ERP Case Studies & Projects | Dhiren Narola"
  description="Case studies from 22 Odoo implementations across 13 countries: ZATCA-compliant automotive ERP, pharma manufacturing, and WhatsApp automation at scale."
  path="/work"
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Work', path: '/work' }])]}
>
  <header class="hero hero--sub">
    <div class="container">
      <nav class="crumbs rv-h" data-h="1" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Work</span>
      </nav>
      <h1 class="rv-h hub-h1" data-h="2">Selected work, with the numbers left in.</h1>
      <p class="lede rv-h" data-h="3">
        22 implementations across 13 countries — the ones I can share are
        published as full case studies, the rest are confidential under NDA. Written for the people who
        sign off on ERP budgets.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <ol class="cases">
        {work.map((cs, i) => <CaseRow entry={cs} index={i} headingLevel="h2" />)}
      </ol>

      <div class="nda">
        <span class="kicker">Not published</span>
        <div>
          <h2 class="nda-h">The rest of my 22 implementations are under NDA</h2>
          <p>
            US and European enterprise engagements, Gulf implementations, and the
            ongoing New Zealand telecom ERP. References available privately on
            request.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Have a project like one of these?" />
</Base>

<style>
  .hub-h1 {
    font-size: var(--text-4xl);
    max-width: 18ch;
  }

  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nda {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-ink);
  }

  @media (min-width: 900px) {
    .nda {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: var(--s-5);
    }
  }

  .nda .label {
    margin: 0;
    padding-top: 0.3rem;
  }

  .nda-h {
    font-size: var(--text-2xl);
    margin-bottom: var(--s-3);
  }

  .nda p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 58ch;
  }
</style>
