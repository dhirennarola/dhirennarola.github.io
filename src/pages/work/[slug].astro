---
import Base from '../../layouts/Base.astro';
import Testimonial from '../../components/Testimonial.astro';
import CtaBand from '../../components/CtaBand.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import { getCollection, render } from 'astro:content';
import { recommendations } from '../../data/facts';
import { breadcrumbs, articleSchema } from '../../data/schema';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/work/${entry.id}`;

const related = (await getCollection('work'))
  .filter((w) => w.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

// "Odoo 18 (upgraded from 15)" -> "Odoo 18" for the diagram label
// The big number row only appears when the results are real numbers.
const numericKpis = d.heroKpis.filter((k) => /^[~+<>]?\d/.test(k.value));
const showKpis = numericKpis.length >= 2;
const platform = d.odooVersion.match(/Odoo\s*\d+/)?.[0] ?? 'Odoo';

const quote = d.testimonialName
  ? recommendations.find((r) => r.name === d.testimonialName)
  : undefined;

const jsonLd = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
    { name: d.title, path },
  ]),
  articleSchema({
    headline: d.title,
    description: d.summary,
    path,
    datePublished: '2026-07-01',
  }),
];
---

<Base
  title={d.metaTitle ?? `${d.title} — Case Study | Dhiren Narola`}
  description={d.metaDescription ?? d.summary}
  path={path}
  ogType="article"
  ogImage={`/og/work-${entry.id}.png`}
  jsonLd={jsonLd}
>
  <header class="hero hero--sub cs-hero">
    <div class="container">
      <nav class="crumbs rv-h" data-h="1" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/work/">Work</a> <span aria-hidden="true">/</span>
        <span>{d.industry}</span>
      </nav>
      <div class="cs-meta">
        <span class="label">{d.industry} · {d.country} · {d.odooVersion}</span>
        <span class:list={['status', { 'status--progress': !/live/i.test(d.status) }]}><span class="dot" aria-hidden="true"></span>{d.status}</span>
      </div>
      <h1 class="rv-h cs-h1" data-h="2">{d.title}</h1>
      <p class="lede rv-h" data-h="3">{d.summary}</p>

      {showKpis && <dl class="ledger cs-kpis" style={`--cols: ${d.heroKpis.length}`}>
        {d.heroKpis.map((kpi) => (
          <div class="stat">
            <dt class="stat-lbl">{kpi.label}{kpi.basis && <span class="kpi-basis"> — {kpi.basis}</span>}</dt>
            <dd class="stat-num">{kpi.value}</dd>
          </div>
        ))}
      </dl>}
    </div>
  </header>

  {d.before && (
    <section class="section section--subtle section--tight" aria-labelledby="changed">
      <div class="container">
        <h2 id="changed" class="kicker">What changed</h2>
        <BeforeAfter before={d.before} platform={platform} modules={d.modules} integrations={d.integrations} />
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container cs-layout">
      <article class="prose">
        <Content />

        <div class="cs-author">
          <p>
            <strong>Delivered by Dhiren Narola</strong> — Odoo Architect &amp; AI
            Automation Engineer. <a href="/about/">About me</a> ·
            <a href="/contact/">Discuss a similar project</a>
          </p>
        </div>
      </article>

      <aside class="cs-side">
        <div class="side-block">
          <h3>Project facts</h3>
          <dl class="facts-list">
            <div><dt>Client</dt><dd>{d.clientLabel}</dd></div>
            <div><dt>Country</dt><dd>{d.country}</dd></div>
            {d.companySize && <div><dt>Scale</dt><dd>{d.companySize}</dd></div>}
            <div><dt>Platform</dt><dd>{d.odooVersion}</dd></div>
            <div><dt>My role</dt><dd>{d.role}</dd></div>
            {d.timeline && <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>}
          </dl>
        </div>

        <div class="side-block">
          <h3>Modules</h3>
          <div class="tag-row">
            {d.modules.map((m) => <span class="tag">{m}</span>)}
          </div>
        </div>

        {d.integrations.length > 0 && (
          <div class="side-block">
            <h3>Integrations</h3>
            <div class="tag-row">
              {d.integrations.map((int) => <span class="tag">{int}</span>)}
            </div>
          </div>
        )}

        {quote && <Testimonial {...quote} />}
      </aside>
    </div>
  </section>

  <section class="section section--subtle section--tight">
    <div class="container">
      <div class="related">
        <span class="kicker">More case studies</span>
        <ul class="related-list">
          {related.map((r) => (
            <li>
              <a href={`/work/${r.id}/`} class="related-link">
                <span class="label">{r.data.industry} · {r.data.country}</span>
                <span class="related-h">{r.data.title}</span>
                <span class="link-arr">Read the case study <span class="arr" aria-hidden="true"><svg class="i-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand
    title="Facing something similar?"
    desc="Bring the messy version of your situation — the discovery call is where it gets untangled. Written proposal within 3–5 business days after."
  />
</Base>

<style>
  .cs-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-bottom: var(--s-5);
  }

  .cs-meta .label {
    margin: 0;
  }

  .cs-h1 {
    max-width: 26ch;
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.1rem);
  }

  .cs-kpis {
    margin-top: var(--s-7);
  }

  .kpi-basis {
    color: var(--ink-faint);
    font-weight: 400;
  }

  .cs-layout {
    display: grid;
    gap: var(--s-7);
    align-items: start;
  }

  @media (min-width: 980px) {
    .cs-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--s-8);
    }
  }

  .cs-side {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  @media (min-width: 980px) {
    .cs-side {
      position: sticky;
      top: calc(var(--nav-h) + 1.5rem);
    }
  }

  .side-block {
    border-top: 1px solid var(--rule-ink);
    padding-top: var(--s-3);
  }

  .side-block h3 {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    margin-bottom: var(--s-3);
  }

  .facts-list {
    margin: 0;
  }

  .facts-list div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--s-3);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .facts-list div:last-child {
    border-bottom: 0;
  }

  .facts-list dt {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .facts-list dd {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--ink);
    font-weight: 530;
  }

  .cs-author {
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .cs-author p {
    margin: 0;
    font-size: var(--text-sm);
  }

  .related {
    display: grid;
    gap: var(--s-3);
    border-top: 1px solid var(--rule-ink);
    padding-top: var(--s-4);
  }

  @media (min-width: 900px) {
    .related {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: var(--s-5);
    }
  }

  .related > .label {
    margin: 0;
    padding-top: 0.3rem;
  }

  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 720px) {
    .related-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .related-list li {
    margin: 0;
  }

  .related-link {
    display: grid;
    gap: 0.25rem;
  }

  .related-link .label {
    margin: 0;
  }

  .related-h {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--ink-strong);
  }

  .related-link:hover .related-h {
    color: var(--accent-strong);
  }
</style>
