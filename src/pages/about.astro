---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Testimonial from '../components/Testimonial.astro';
import CtaBand from '../components/CtaBand.astro';
import portrait from '../assets/dhiren-narola.png';
import {
  numbers,
  career,
  certifications,
  education,
  recommendations,
  odooStoreApps,
  contact,
} from '../data/facts';
import { breadcrumbs } from '../data/schema';
---

<Base
  title="About Dhiren Narola — Odoo Architect & AI Automation Engineer"
  description="Odoo 18 certified architect: from junior engineer to leading 7 developers at a Silver Partner, now serving clients across 13 countries directly."
  path="/about"
  ogType="profile"
  headerLight
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }])]}
>
  <!-- ===== Intro: single clear hero ===== -->
  <section class="section section--l about-hero">
    <div class="container about-grid">
      <div>
        <span class="kicker">About</span>
        <h1 class="about-h1">I design and deliver Odoo ERPs, and I stay accountable for them.</h1>
        <p class="lede">
          Most ERP projects fail in the gap between what the business needs and
          what gets built. I have spent five years working in that gap, first as
          an engineer and team lead at an Odoo partner, now as an independent
          architect.
        </p>
        <div class="intro-actions rv-h" data-h="4">
          <a href="/contact/" class="btn btn--primary">Work with me <span class="arr" aria-hidden="true"><svg class="i-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></a>
          <a href="/profile/" class="btn btn--outline">View résumé (PDF)</a>
        </div>
      </div>
      <div class="about-visual rv-h" data-h="3">
        <Image
          src={portrait}
          alt="Dhiren Narola — Odoo Architect and AI Automation Engineer"
          width={640}
          widths={[320, 480, 640, 960]}
          sizes="(max-width: 640px) min(310px, 70vw), 310px"
          loading="eager"
          fetchpriority="high"
          class="about-portrait"
        />
        <p class="about-chip">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="m9 14.5-1.5 7.5L12 19.5l4.5 2.5-1.5-7.5"/><path d="m9.5 9 1.8 1.8 3.2-3.3"/></svg>
          <span><strong>Odoo 18 certified</strong> · functional certification by Odoo S.A.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Story ===== -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="The story"
        title="Five years in the Odoo ecosystem"
      />
      <div class="story-copy after-label">
        <p>
          I started working with Odoo in 2021, while still finishing my
          engineering degree, and I have stayed with it since. ERP rewards depth:
          every implementation teaches patterns the next one needs. After
          <strong>{numbers.implementationsExact}</strong> across
          <strong>13 countries</strong>, very little surprises me.
        </p>
        <p>
          I spent nearly five years at <strong>{career.synodica.company}</strong>, an
          <a href={career.synodica.partnerUrl} target="_blank" rel="noopener">Odoo Silver Partner</a>.
          I went from junior engineer to <strong>Development Team Lead</strong>,
          running a team of {numbers.developersLed} developers across four
          projects at once, with architecture decisions, hiring and client
          strategy. I also brought AI-assisted development into the team, which
          raised its productivity by about 30%.
        </p>
        <p>
          Since mid-2026 I work directly with clients as an independent
          architect. Right now that includes
          <strong>{career.currentEngagement.descriptor}</strong>, where I am
          designing and building their ERP from start to finish.
        </p>
        <p>
          What I really offer is <strong>ownership</strong>: one person who
          understands your business case, designs the system, writes or directs
          the code, and answers for the result. That is why none of my
          {numbers.implementations} implementations has failed at go-live.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Timeline ===== -->
  <section class="section section--subtle">
    <div class="container">
      <SectionHeader
        eyebrow="Career"
        title="Four roles in five years"
        desc="One ecosystem, with more ownership at each step. Every role is listed on LinkedIn."
      />
      <div class="tl after-label">
        <div class="tl-item tl-item--now">
          <h3>{career.independent.role}</h3>
          <div class="tl-meta">{career.independent.period} · Remote, global · <span class="tl-current">Current</span></div>
          <p>{career.independent.note} Currently architecting the ERP platform for {career.currentEngagement.descriptor}.</p>
        </div>
        <div class="tl-item">
          <h3>Development Team Lead, {career.synodica.company} <span class="pill pill--accent tl-pill">{career.synodica.badge}</span></h3>
          <div class="tl-meta">Sep 2024 – Jul 2026 · {career.synodica.location}</div>
          <p>Led {numbers.developersLed} developers across 4 concurrent ERP projects. ~30% productivity gain via AI-driven workflows; ~25% fewer delivery delays via structured deployment processes.</p>
        </div>
        <div class="tl-item">
          <h3>Software Engineer → Senior Software Engineer</h3>
          <div class="tl-meta">Sep 2021 – Aug 2024 · {career.synodica.company}</div>
          <p>Full-cycle delivery across automotive, pharma, facilities, retail and IT services. Revamped a 10,000+ line legacy module for a ~30% performance gain. Joined while completing {education.degree} ({education.year}, 8.5 CGPA).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Credentials + products ===== -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Credentials"
        title="Certification and published work"
      />
      <div class="cards cards--3" data-stagger>
        <div class="card card--hover">
          <span class="pill self-start">Vendor certification</span>
          <h3>Odoo 18 Functional Certification</h3>
          <p class="clamp3 grow">
            Official certification issued by Odoo S.A., covering Accounting,
            Sales, Purchase, Inventory, HR and Manufacturing.
          </p>
          <a
            href="https://www.linkedin.com/in/dhirennarola/details/certifications/"
            target="_blank"
            rel="noopener"
            class="link-arr"
          >Verify on LinkedIn <span class="arr" aria-hidden="true"><svg class="i-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></a>
        </div>
        <div class="card card--hover">
          <span class="pill self-start">Professional development</span>
          <h3>AI for Business Decision-Making</h3>
          <p class="clamp3 grow">
            {certifications[1].issuer} ({certifications[1].year}) · plus
            {certifications[2].name} ({certifications[2].issuer}, {certifications[2].year}).
          </p>
        </div>
        <div class="card card--hover">
          <span class="pill self-start">Published products</span>
          <h3>3 apps on the Odoo App Store</h3>
          <p class="clamp3 grow">
            {odooStoreApps.map((a) => a.name).join(' · ')}. Built and
            maintained for Odoo 19 and 20.
          </p>
          <a href={contact.odooApps} target="_blank" rel="noopener" class="link-arr">
            View on the App Store <span class="arr" aria-hidden="true"><svg class="i-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Testimonials ===== -->
  <section class="section section--surface" id="testimonials">
    <div class="container">
      <SectionHeader
        eyebrow="References"
        title="What clients and colleagues say"
        desc="Four LinkedIn recommendations: two clients, my former director and a colleague. Each one links to the original."
      />
      <div class="cards refs-grid">
        {recommendations.map((rec, i) => (
          <Testimonial {...rec} featured={i === 0} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="The person you just read about answers your message personally."
  />
</Base>

<style>
  .story-copy {
    max-width: 68ch;
  }

  .tl {
    max-width: 68ch;
  }

  .self-start {
    align-self: flex-start;
  }

  .about-hero {
    padding-top: calc(var(--nav-h) + var(--sec-m));
  }

  .about-grid {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .about-h1 {
    max-width: 20ch;
  }

  .intro-actions {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-5);
    flex-wrap: wrap;
  }

  .about-visual {
    justify-self: center;
    position: relative;
  }

  .about-portrait {
    width: min(310px, 70vw);
    height: auto;
    border-radius: var(--radius);
  }

  .about-chip {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    max-width: min(310px, 70vw);
    margin: var(--s-3) 0 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .about-chip svg {
    flex: none;
    margin-top: 2px;
    color: var(--accent-strong);
  }


  /* story */
  .story-copy {
    max-width: 70ch;
    color: var(--ink-soft);
  }

  /* timeline */
  .tl {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    max-width: 720px;
  }

  .tl::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(var(--accent), var(--line));
    border-radius: 2px;
  }

  .tl-item {
    position: relative;
    padding-left: 2.2rem;
  }

  .tl-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 3px solid var(--line);
  }

  .tl-item--now::before {
    border-color: var(--ok);
    box-shadow: 0 0 0 4px var(--ok-tint);
  }

  .tl-item h3 {
    font-size: var(--text-lg);
    margin-bottom: 2px;
  }

  .tl-pill {
    margin-left: 6px;
    vertical-align: 2px;
  }

  .tl-meta {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: var(--s-2);
  }

  .tl-current {
    color: var(--ok);
    font-weight: 600;
  }

  .tl-item p {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin: 0;
    max-width: 58ch;
  }
</style>
