---
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Faq from '../../components/Faq.astro';
import { services } from '../../data/services';
import { contact, whatsappUrl } from '../../data/facts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../data/schema';

const service = services.find((s) => s.slug === 'ai-odoo')!;
const path = '/services/ai-odoo';

const jsonLd = [
  serviceSchema({ name: service.name, description: service.metaDescription, path }),
  faqSchema(service.faqs),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
    { name: 'AI + Odoo', path },
  ]),
];
---

<Base
  title={service.metaTitle}
  description={service.metaDescription}
  path={path}
  jsonLd={jsonLd}
>
  <!-- ===== Hero (dark, AI stack visual) ===== -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="kicker">AI + Odoo · checked against the Odoo 19 and 20 release notes</span>
          <h1 class="ai-h1">Use the AI already in Odoo. Build only what is missing.</h1>
          <p class="hero-lede">{service.lede}</p>
          <div class="hero-ctas rv-h" data-h="4">
            <a href="/contact/" class="btn btn--primary btn--lg">Map your AI opportunities <span class="arr" aria-hidden="true"><svg class="i-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></a>
            <a href="#capabilities" class="btn btn--outline btn--lg">See the capabilities</a>
          </div>
        </div>
        <div class="hero-visual rv-h" data-h="3">
          <div class="stack" aria-hidden="true">
            <div class="stack-layer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a9bbd4" stroke-width="1.8"><path d="M8 12h8M12 8v8" stroke-linecap="round"/><circle cx="12" cy="12" r="9"/></svg>
              <div>Channels<small>WhatsApp · website chat · email · portal</small></div>
            </div>
            <div class="stack-conn"></div>
            <div class="stack-layer stack-layer--ai">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#12b5c9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8L4.3 10.7l5.8 1.9L12 18.4l1.9-5.8 5.8-1.9-5.8-1.9Z"/></svg>
              <div>AI layer<small>Odoo AI agents and skills · MCP · custom tools</small></div>
            </div>
            <div class="stack-conn"></div>
            <div class="stack-layer stack-layer--core">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5b9bff" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 21V9" /></svg>
              <div>Odoo core<small>Sales · Inventory · MRP · Accounting · HR</small></div>
            </div>
            <div class="stack-conn"></div>
            <div class="stack-layer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a9bbd4" stroke-width="1.8" stroke-linecap="round"><path d="M12 20V10M18 20V4M6 20v-4"/></svg>
              <div>Rules and limits<small>Access rights · approvals · logs · credit budget</small></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Capabilities ===== -->
  <section class="section section--l" id="native">
    <div class="container">
      <SectionHeader
        eyebrow="Built into Odoo"
        title="What Odoo 19 and 20 already do, and what I add"
        desc="Before paying for custom AI, use what your licence already includes. This table follows Odoo’s own release notes."
      />
      <div class="native-wrap">
        <table class="native">
          <thead>
            <tr>
              <th scope="col" class="label">Feature</th>
              <th scope="col" class="label">Odoo 19</th>
              <th scope="col" class="label">Odoo 20</th>
              <th scope="col" class="label">What I add</th>
            </tr>
          </thead>
          <tbody>
          <tr>
            <th scope="row">AI agents</th>
            <td>Chat agents with instructions, sources and topics. Without topics they can answer but not change data.</td>
            <td>Agents can create and update records, ask permission with buttons and run inside automated actions. Topics are now called skills.</td>
            <td>I write the skills as code that enforces your business rules, and set who may use which agent.</td>
          </tr>
          <tr>
            <th scope="row">Ask AI and search</th>
            <td>Ask questions, open views, summarise chatter and search in plain language.</td>
            <td>Same, plus voice dictation to agents.</td>
            <td>Default prompts per app, and training so your team actually uses it.</td>
          </tr>
          <tr>
            <th scope="row">AI fields</th>
            <td>AI fills text, number, date, tag and other fields from a prompt.</td>
            <td>Available as before.</td>
            <td>Pick the few fields worth paying for, and keep prompts short and testable.</td>
          </tr>
          <tr>
            <th scope="row">Bill scanning (OCR)</th>
            <td>Reads vendor bills, refunds and bank statements. Can auto-post after three clean bills from a vendor.</td>
            <td>Adds bill line prediction.</td>
            <td>Approval limits, and country rules such as ZATCA that scanning alone does not cover.</td>
          </tr>
          <tr>
            <th scope="row">Website live chat</th>
            <td>An AI agent answers on your website and creates a lead when it cannot help.</td>
            <td>Adds record preview cards in chat.</td>
            <td>WhatsApp is not covered by native AI. I build WhatsApp conversations that read and write Odoo.</td>
          </tr>
          <tr>
            <th scope="row">MCP server</th>
            <td>Not included.</td>
            <td>Connects Claude, ChatGPT and other assistants to Odoo. Five read-only tools are on by default; tools that write must be switched on one by one.</td>
            <td>Which tools to expose, sign-in and client approval rules, and access rights under the new Odoo 20 model.</td>
          </tr>
          <tr>
            <th scope="row">Cost</th>
            <td>Your own OpenAI or Gemini key on Odoo.sh and on-premise.</td>
            <td>Every AI feature uses Odoo credits.</td>
            <td>A budget per use case, monitoring, and switching off what does not pay back.</td>
          </tr>
          </tbody>
        </table>
      </div>
      <p class="native-src">
        Sources: <a href="https://www.odoo.com/odoo-19-release-notes" target="_blank" rel="noopener">Odoo 19 release notes</a>,
        <a href="https://www.odoo.com/odoo-20-release-notes" target="_blank" rel="noopener">Odoo 20 release notes</a> and the
        <a href="https://www.odoo.com/documentation/20.0/applications/productivity/ai.html" target="_blank" rel="noopener">Odoo AI documentation</a>.
        Checked October 2026. Most AI features need Odoo Enterprise.
      </p>
    </div>
  </section>

  <section class="section section--subtle" id="capabilities">
    <div class="container">
      <SectionHeader
        eyebrow="Custom work"
        title="Where custom AI still pays"
        desc="These are the gaps I see on real projects once the native features are set up."
      />
      <div class="cards cards--3">
        <div class="card">
          <h3>WhatsApp conversations</h3>
          <p class="grow">Guided flows for requests, status, subscriptions and payments, written straight into Odoo. In production for 4,000+ customers, replacing about half a call center.</p>
        </div>
        <div class="card">
          <h3>Flows across other systems</h3>
          <p class="grow">Agents and automations that also reach your bank, telecom, logistics or government portals, which native Odoo AI cannot see.</p>
        </div>
        <div class="card">
          <h3>Documents Odoo cannot read yet</h3>
          <p class="grow">Delivery notes, job cards, certificates and country-specific forms, extracted with checks against your own data before anything is posted.</p>
        </div>
        <div class="card">
          <h3>Approvals with clear limits</h3>
          <p class="grow">AI prepares the work, a person approves it. Amount limits, roles and logs decide what the AI may do on its own.</p>
        </div>
        <div class="card">
          <h3>Country rules</h3>
          <p class="grow">ZATCA Phase 2 and other e-invoicing rules stay deterministic and tested. AI helps around them, never inside the legal step.</p>
        </div>
        <div class="card">
          <h3>Upgrade-safe custom AI</h3>
          <p class="grow">Custom skills and tools kept small and documented, so the next Odoo version does not break them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== AI by function ===== -->
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Where it lands" title="AI by business function" />
      <div class="cards cards--3" data-stagger>
        <div class="card">
          <h3 class="fn-h">Sales</h3>
          <ul class="check-list mt-3">
            <li>Quote drafts from emails &amp; RFQs</li>
            <li>Lead triage and enrichment</li>
            <li>Customer history briefs before every call</li>
          </ul>
        </div>
        <div class="card">
          <h3 class="fn-h">Inventory</h3>
          <ul class="check-list mt-3">
            <li>Delivery-note OCR → instant receipts</li>
            <li>Reorder signals from real demand</li>
            <li>Discrepancy detection before stocktakes</li>
          </ul>
        </div>
        <div class="card">
          <h3 class="fn-h">Manufacturing</h3>
          <ul class="check-list mt-3">
            <li>Work-order summaries &amp; shift handovers</li>
            <li>Quality-check capture from the floor</li>
            <li>Maintenance-window prediction</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Honest sequencing (dark) ===== -->
  <section class="section section--l section--dark on-dark">
    <div class="container">
      <SectionHeader
        eyebrow="The honest part"
        title="Where AI pays — and where it's just expensive"
        desc="AI multiplies whatever your ERP already is. Clean processes become leverage; chaos becomes faster chaos. I hold clients to the sequence."
      />
      <div class="cards" data-stagger>
        <div class="card card--navy">
          <h3 class="ok-h">Worth your money</h3>
          <ul class="check-list mt-3">
            <li>Documents your team retypes into the ERP</li>
            <li>Questions customers ask on repeat</li>
            <li>Approvals that wait on someone noticing</li>
            <li>Reports that take a day to assemble</li>
          </ul>
        </div>
        <div class="card card--navy">
          <h3 class="warn-h">Not yet — fix the base first</h3>
          <ul class="warn-list mt-3">
            <li>Forecasting on top of unreliable inventory data</li>
            <li>Chatbots bolted onto broken processes</li>
            <li>"AI strategy" that can't name a workflow</li>
            <li>Autonomy without audit trails</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="FAQ" title="Fair questions" />
      <div class="after-label">
        <Faq items={service.faqs} />
      </div>
    </div>
  </section>

  <!-- ===== CTA (split panel) ===== -->
  <section class="section section--l pt-0">
    <div class="container">
      <div class="cta-panel">
        <div class="cta-panel-grid">
          <div>
            <span class="eyebrow">Free · 30 minutes</span>
            <h2 class="cta-h">Which workflow would pay for automation first?</h2>
            <p class="cta-p">Bring your process list. You leave with an honest opportunity map — ranked by ROI, including the "not worth it" column.</p>
            <div class="cta-btns">
              <a href="/contact/" class="btn btn--primary btn--lg">Book the AI discovery call <span class="arr" aria-hidden="true"><svg class="i-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span></a>
              <a href={whatsappUrl(service.whatsappMsg)} target="_blank" rel="noopener" class="btn btn--outline btn--lg">WhatsApp me</a>
            </div>
            <div class="cta-note"><span class="dot" aria-hidden="true"></span> Reply within {contact.responseTime} · no pitch, prepared questions</div>
          </div>
          <div class="card card--navy map-card" aria-hidden="true">
            <div class="map-title">Your opportunity map — sample</div>
            <div class="map-rows">
              <div class="map-row"><span>Vendor bill entry → OCR</span><b class="roi-hi">High ROI</b></div>
              <div class="map-row"><span>Customer status queries → WhatsApp</span><b class="roi-hi">High ROI</b></div>
              <div class="map-row"><span>Approval chasing → agent</span><b class="roi-med">Medium</b></div>
              <div class="map-row dim"><span>Demand forecasting</span><b class="roi-not">Not yet — fix data first</b></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .ai-h1 {
    max-width: 16ch;
  }

  /* Native vs custom table: scrolls inside its own box on phones */
  .native-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .native {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: var(--text-sm);
    border-top: 1px solid var(--line-strong);
  }

  .native th,
  .native td {
    text-align: left;
    vertical-align: top;
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .native thead th {
    padding-block: var(--s-3);
  }

  .native thead .label {
    display: table-cell;
    margin: 0;
  }

  .native tbody th {
    width: 16%;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink-strong);
  }

  .native td:last-child {
    color: var(--ink-strong);
    font-weight: 500;
    padding-right: 0;
  }

  .native-src {
    margin: var(--s-4) 0 0;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .native-src a {
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 3px;
  }

  .mt-3 {
    margin-top: var(--s-3);
  }

  .pt-0 {
    padding-top: 0;
  }

  /* AI stack visual */
  .stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: min(400px, 88vw);
  }

  .stack-layer {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
    background: var(--bg-raised);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: var(--text-sm);
    color: var(--ink-strong);
    font-weight: 600;
  }

  .stack-layer small {
    display: block;
    font-weight: 400;
    color: var(--ink-faint);
    font-size: var(--text-xs);
  }

  .stack-layer svg {
    flex: none;
    stroke: var(--ink-faint);
  }

  /* AI sits on Odoo as an assistive layer: dashed, the way the site draws AI */
  .stack-layer--ai {
    border-style: dashed;
    border-color: var(--accent);
  }

  .stack-layer--ai svg,
  .stack-layer--core svg {
    stroke: var(--accent-strong);
  }

  .stack-layer--core {
    border-color: var(--accent-line);
    background: var(--accent-tint);
  }

  .stack-conn {
    align-self: center;
    width: 1px;
    height: 14px;
    background: var(--accent);
  }

  /* function columns */
  .fn-h {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .fn-ic {
    width: 38px;
    height: 38px;
    border-radius: 10px;
  }

  .fn-ic svg {
    width: 18px;
    height: 18px;
  }

  .ok-h {
    color: #7fd7aa;
  }

  .warn-h {
    color: #f6c177;
  }

  .warn-list {
    padding-left: 1.1rem;
    margin-bottom: 0;
  }

  .warn-list li {
    font-size: var(--text-sm);
  }

  /* CTA panel */
  .cta-h {
    max-width: 18ch;
  }

  .cta-p {
    max-width: 44ch;
  }

  .cta-btns {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-5);
  }

  .map-card {
    box-shadow: none;
  }

  .map-title {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--s-3);
  }

  .map-rows {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .map-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 0.6rem 0;
    font-size: var(--text-sm);
  }

  .map-row span {
    color: var(--ink);
  }

  .map-row.dim {
    opacity: 0.65;
  }

  .roi-hi {
    color: var(--ok-ink);
    font-weight: 700;
  }

  .roi-med {
    color: var(--accent-ink);
    font-weight: 700;
  }

  .roi-not {
    color: var(--ink-soft);
    font-weight: 700;
  }
</style>
