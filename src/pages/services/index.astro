---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
import { engagement } from '../../data/facts';
import { breadcrumbs } from '../../data/schema';
---

<Base
  title="Services — Odoo Implementation, Rescue & AI | Dhiren Narola"
  description="End-to-end Odoo expertise: implementation & architecture, ERP rescue, AI automation, integrations & ZATCA compliance, and dedicated dev teams."
  path="/services"
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }])]}
>
  <header class="hero hero--sub">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <span>Services</span>
      </nav>
      <h1 class="hub-h1">Five ways to work with me, one owner for all of them</h1>
      <p class="lede">
        From the first architecture conversation to support after go-live. That
        includes two things many consultants avoid: rescuing failed projects, and
        saying plainly where AI is not worth the money.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <ul class="svc-list">
        {services.map((service) => (
          <li>
            <a href={`/services/${service.slug}/`} class="svc-row">
              <span class="svc-name">
                <span class="svc-h">{service.nav.replace('e-', 'e‑')}</span>
                {service.pill && (
                  <span class="pill">
                    {service.pill.label}
                  </span>
                )}
              </span>
              <span class="svc-body">
                <span class="svc-headline">{service.headline}</span>
                <span class="svc-lede">{service.lede}</span>
              </span>
              <span class="svc-go" aria-hidden="true"><svg class="i-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
            </a>
          </li>
        ))}
      </ul>

      <div class="eng">
        <span class="kicker">Engagement models</span>
        <div>
          <div class="tag-row eng-models">
            {engagement.models.map((model) => <span class="tag">{model}</span>)}
          </div>
          <p>{engagement.note}</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hub-h1 {
    max-width: 22ch;
  }

  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-ink);
  }

  .svc-list li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .svc-row {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6) 0;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .svc-row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 8.4fr) 2rem;
      gap: var(--s-5);
    }
  }

  .svc-name {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .svc-h {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.2;
    color: var(--ink-strong);
    transition: color var(--t-fast) ease;
  }

  .svc-body {
    display: grid;
    gap: var(--s-2);
    max-width: 68ch;
  }

  .svc-headline {
    font-weight: 600;
    color: var(--ink-strong);
  }

  .svc-lede {
    font-size: var(--text-sm);
  }

  .svc-go {
    display: none;
    color: var(--ink-faint);
    padding-top: 0.6rem;
    transition: transform var(--t-med) var(--ease-out), color var(--t-fast) ease;
  }

  @media (min-width: 900px) {
    .svc-go {
      display: block;
    }
  }

  .svc-row:hover .svc-h,
  .svc-row:hover .svc-go {
    color: var(--accent-strong);
  }

  .svc-row:hover .svc-go {
    transform: translateX(3px);
  }

  .eng {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-7);
  }

  @media (min-width: 900px) {
    .eng {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: var(--s-5);
    }
  }

  .eng .kicker {
    margin: 0;
  }

  .eng-models {
    margin-bottom: var(--s-4);
  }

  .eng p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 60ch;
  }
</style>
