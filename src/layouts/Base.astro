---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site, contact, numbers, odooStoreApps } from '../data/facts';
import { pageUrl } from '../data/schema';

interface Props {
  title: string;
  description: string;
  /** Path beginning with / — used for canonical + OG url */
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: object[];
  noindex?: boolean;
  /** Kept so older pages still compile: every header is light by default */
  headerLight?: boolean;
  /** Navy header bar, for pages that open with the navy brand band (the homepage) */
  navDark?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/og/default.png',
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  headerLight = false,
  navDark = false,
} = Astro.props;

const canonical = pageUrl(path);
/** Staging builds (npm run build:stage) are never indexed and never tracked. */
const isStage = import.meta.env.PUBLIC_STAGE === '1';
const robotsOff = noindex || isStage;
const ogImageAbs = new URL(ogImage, site.url).href;

/* No <meta name="keywords">. Google announced in 2009 that it disregards the
   tag for web ranking and has never reversed that; Bing has separately called
   a stuffed keywords tag a spam indicator. So the tag was upside-free at best.
   The topical signal lives in the page copy and in the Person schema's
   knowsAbout / alternateName below, which search engines do read. */

/** Person schema present on every page — the entity Google associates with "Dhiren Narola". */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  givenName: 'Dhiren',
  familyName: 'Narola',
  alternateName: [
    'Dhiren',
    'Narola',
    'Dhiren Narola Odoo',
    'Dhiren Narola Odoo Developer',
    'Dhiren Narola AI Automation',
  ],
  jobTitle: 'Odoo Architect & AI Automation Engineer',
  description:
    'Odoo 18 certified ERP architect and AI automation engineer with 22 Odoo implementations delivered across 13 countries. Specialist in Odoo ERP implementation, ERP rescue, ZATCA e-invoicing compliance, and AI-powered business automation.',
  url: site.url,
  image: `${site.url}/assets/dhiren-narola.jpg`,
  email: `mailto:${contact.email}`,
  telephone: contact.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Surat',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  nationality: { '@type': 'Country', name: 'India' },
  sameAs: [contact.linkedin, contact.github, contact.odooApps],
  knowsLanguage: ['en', 'hi', 'gu'],
  knowsAbout: [
    'Odoo ERP',
    'Odoo Development',
    'Odoo Implementation',
    'Odoo Customization',
    'ERP Architecture',
    'ERP Implementation',
    'ERP Rescue and Recovery',
    'AI Automation',
    'AI Agents',
    'LLM Integration',
    'ZATCA Phase 2 e-invoicing',
    'WhatsApp Business API automation',
    'Business Process Automation',
    'Odoo Manufacturing MRP',
    'Odoo Accounting',
    'Saudi Arabia payroll (GOSI, EOS)',
    'WooCommerce Odoo integration',
    'Python',
    'PostgreSQL',
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Odoo Architect / Odoo Developer / ERP Consultant',
    occupationalCategory: 'Software Architect',
    skills:
      'Odoo 16–20 (and 11–15), ERP implementation, ERP rescue, AI automation, ZATCA e-invoicing, Python, PostgreSQL, WhatsApp Business API, LLM integrations',
  },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'Odoo 18 Functional Certification',
    recognizedBy: { '@type': 'Organization', name: 'Odoo S.A.' },
  },
  owns: odooStoreApps.map((app) => ({
    '@type': 'SoftwareApplication',
    name: app.name,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Odoo 19, Odoo 20',
    description: app.desc,
    url: contact.odooApps,
    author: { '@id': `${site.url}/#person` },
  })),
};

/** WebSite schema — helps "Dhiren Narola" brand queries resolve to this site. */
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: `${site.name} — Odoo Architect & AI Automation Engineer`,
  alternateName: ['Dhiren Narola', 'dhirennarola.com'],
  url: site.url,
  description: site.tagline,
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#person` },
};

const allSchemas = [personSchema, websiteSchema, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="author" content={site.name} />
    <meta name="creator" content={site.name} />
    <meta name="publisher" content={site.name} />
    {robotsOff ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${site.name} — ${site.title}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {/* Every icon below renders the same "D." mark. Google Search often prefers
        apple-touch-icon over the declared favicons, so when that file held the
        old "dn" wordmark the SERP icon disagreed with the browser tab. Keep
        these in sync — regenerate with `npm run og`, never by hand. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta name="theme-color" content="#fafbfc" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {site.gaMeasurementId && !isStage && (
      <>
        {/* gtag() queues into dataLayer straight away, but the Google script
            itself loads only after the page has finished loading, so it never
            competes with the first paint. Queued events are sent once it arrives. */}
        <script
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.gaMeasurementId}',{anonymize_ip:true});
(function(){
  function load(){ var s=document.createElement('script'); s.async=true; s.src='https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}'; document.head.appendChild(s); }
  function later(){ ('requestIdleCallback' in window) ? requestIdleCallback(load,{timeout:3000}) : setTimeout(load,1500); }
  if(document.readyState==='complete'){ later(); } else { window.addEventListener('load', later, {once:true}); }
})();`}
        />
        {/* Funnel & conversion tracking — captures the journey Enhanced
            Measurement can't: booking intent, actual Calendly bookings
            (postMessage from the embedded iframe), contact channels,
            outbound clicks, PDF downloads, and scroll depth. */}
        <script
          is:inline
          set:html={`(function(){
  function track(n,p){ if(typeof window.gtag==='function'){ window.gtag('event', n, p||{}); } }
  window.__track = track;
  document.addEventListener('click', function(e){
    var el = e.target && e.target.closest ? e.target.closest('a,button') : null;
    if(!el) return;
    var href = (el.getAttribute && el.getAttribute('href')) || '';
    var txt = ((el.textContent||'').replace(/\\s+/g,' ').trim()).slice(0,60);
    if(/^mailto:/i.test(href)){ track('contact_click',{method:'email',link_text:txt,page:location.pathname}); return; }
    if(/^tel:/i.test(href)){ track('contact_click',{method:'phone',link_text:txt,page:location.pathname}); return; }
    if(/wa\\.me|api\\.whatsapp/i.test(href)){ track('contact_click',{method:'whatsapp',link_text:txt,page:location.pathname}); return; }
    if(/\\.pdf($|\\?)/i.test(href)){ track('file_download',{file_name:(href.split('/').pop()||'resume.pdf'),link_text:txt,page:location.pathname}); return; }
    if(/calendly\\.com/i.test(href) || /\\/contact\\/?($|#|\\?)/.test(href) || (el.dataset&&el.dataset.cta==='book') || /book (a|the) (call|discovery|meeting)/i.test(txt)){ track('book_call_click',{link_text:txt,page:location.pathname}); return; }
    if(/linkedin\\.com/i.test(href)){ track('outbound_click',{destination:'linkedin',page:location.pathname}); return; }
    if(/github\\.com/i.test(href)){ track('outbound_click',{destination:'github',page:location.pathname}); return; }
    if(/apps\\.odoo\\.com/i.test(href)){ track('outbound_click',{destination:'odoo_app_store',page:location.pathname}); return; }
  }, true);
  window.addEventListener('message', function(e){
    var d = e && e.data;
    if(d && typeof d.event==='string' && d.event.indexOf('calendly.')===0){
      if(d.event==='calendly.event_scheduled'){ track('meeting_booked',{method:'calendly',page:location.pathname}); }
    }
  });
  var marks=[25,50,75,100], hit={}, pending=false;
  function measure(){ pending=false; var sh=document.documentElement.scrollHeight-window.innerHeight; if(sh<=0) return; var pct=(window.scrollY/sh)*100; for(var i=0;i<marks.length;i++){ var m=marks[i]; if(!hit[m]&&pct>=m){ hit[m]=1; track('scroll_depth',{percent:m,page:location.pathname}); } } }
  window.addEventListener('scroll', function(){ if(!pending){ pending=true; setTimeout(measure,400); } }, {passive:true});
})();`}
        />
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav dark={navDark} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      // The only page script left: Odoo-style tabs. Content is visible at
      // rest, so there is no scroll-triggered motion to set up.
      /* Tabs (industry expertise) */
      document.querySelectorAll('[role="tablist"]').forEach((list) => {
        const tabs = [...list.querySelectorAll<HTMLButtonElement>('.tab')];
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
            tab.setAttribute('aria-selected', 'true');
            const scope = list.closest('section') || document;
            scope.querySelectorAll('.tabpanel').forEach((p) => p.classList.remove('active'));
            scope
              .querySelector('#' + tab.getAttribute('aria-controls'))
              ?.classList.add('active');
          });
        });
      });
    </script>
  </body>
</html>
