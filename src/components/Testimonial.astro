---
import { recommendationsUrl } from '../data/facts';

interface Props {
  quote: string;
  name: string;
  role: string;
  context?: string;
  /** Larger type for the lead quote on a page */
  featured?: boolean;
  class?: string;
  /** False when the recommender's LinkedIn profile is deactivated — see facts.ts */
  verifiable?: boolean;
}

const {
  quote,
  name,
  role,
  context,
  featured = false,
  class: cls,
  verifiable = true,
} = Astro.props;
const initials = name
  .split(' ')
  .map((p) => p[0])
  .slice(0, 2)
  .join('');
---

<figure class:list={['quote-card', { featured }, cls]}>
  <blockquote>{quote}</blockquote>
  <figcaption class="quote-attrib">
    <div class="quote-avatar" aria-hidden="true">{initials}</div>
    <div class="quote-meta">
      <div class="quote-name">{name}</div>
      <div class="quote-role">{role}{context && ` · ${context}`}</div>
    </div>
    {verifiable && (
      <a
        class="verified"
        href={recommendationsUrl}
        target="_blank"
        rel="noopener"
        aria-label={`View ${name}'s recommendation on LinkedIn`}
      >
        On LinkedIn
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </a>
    )}
  </figcaption>
</figure>

<style>
  figure {
    margin: 0;
    border-top: 1px solid var(--line-strong);
    padding-top: var(--s-5);
  }

  .featured blockquote {
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-strong);
  }

  .quote-attrib {
    border-top: 0;
    padding-top: 0;
  }

  .quote-meta {
    flex-grow: 1;
    min-width: 0;
  }

  .verified {
    flex-shrink: 0;
  }
</style>
