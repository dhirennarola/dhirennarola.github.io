---
import Brand from './Brand.astro';

interface Props {
  /** Navy bar for pages whose first band is navy (the homepage) */
  dark?: boolean;
}

const { dark = false } = Astro.props;

const links = [
  { href: '/services/', label: 'Services' },
  { href: '/services/ai-odoo/', label: 'AI + Odoo', match: '/services/ai-odoo' },
  { href: '/industries/', label: 'Industries' },
  { href: '/work/', label: 'Work' },
  { href: '/insights/', label: 'Insights' },
  { href: '/about/', label: 'About' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (l: (typeof links)[number]) => {
  if (l.match) return current.startsWith(l.match);
  // "Services" must not light up while on the AI + Odoo flagship page
  if (l.href === '/services/') return current.startsWith('/services') && !current.startsWith('/services/ai-odoo');
  return current.startsWith(l.href.replace(/\/$/, ''));
};
---

<header class:list={['hd', { 'hd--dark': dark }]} id="hd">
  <div class="hd-inner">
    <a href="/" class="brand" aria-label="Dhiren Narola — home">
      <Brand />
    </a>

    <nav class="hd-links" id="hdLinks" aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class:list={[{ active: isActive(l) }]}>{l.label}</a>
      ))}
      <a href="/contact/" class="btn btn--primary hd-cta">
        Book a call <span class="arr" aria-hidden="true"><svg class="i-arr" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
      </a>
    </nav>

    <button
      class="hd-toggle"
      id="hdToggle"
      aria-expanded="false"
      aria-controls="hdLinks"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  /* Always a light bar with a hairline: every page now opens light. */
  .hd {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: rgba(250, 251, 252, 0.96);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .hd-inner {
    max-width: var(--c-lg);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
  }

  @media (min-width: 1600px) {
    .hd-inner {
      max-width: var(--c-xl);
    }
  }

  /* Wordmark — script "Dhiren." SVG; letters follow currentColor */
  .brand {
    display: flex;
    align-items: center;
    color: var(--ink-strong);
    line-height: 1;
  }

  .brand :global(.brand-mark) {
    height: 1.8rem;
  }

  .hd-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .hd-links a:not(.hd-cta) {
    font-size: var(--text-sm);
    font-weight: 520;
    color: var(--ink-soft);
    padding: 0.4rem 0;
    position: relative;
    transition: color var(--t-fast) ease;
  }

  .hd-links a:not(.hd-cta):hover {
    color: var(--ink-strong);
  }

  .hd-links a.active {
    color: var(--ink-strong);
  }

  .hd-links a.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc((var(--nav-h) - 2.4rem) / -2);
    height: 2px;
    background: var(--accent);
  }

  .hd-cta {
    height: 38px;
    padding-inline: 1rem;
  }

  /* navy variant: same layout, brand colours reversed */
  .hd--dark {
    background: var(--navy-900);
    border-bottom-color: var(--navy-line);
  }

  .hd--dark .brand,
  .hd--dark .hd-toggle {
    color: #fff;
  }

  .hd--dark .hd-links a:not(.hd-cta) {
    color: var(--td-soft);
  }

  .hd--dark .hd-links a:not(.hd-cta):hover,
  .hd--dark .hd-links a.active {
    color: #fff;
  }

  /* mobile toggle */
  .hd-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    background: none;
    border: 0;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: var(--ink-strong);
  }

  .hd-toggle span {
    width: 22px;
    height: 2px;
    background: currentColor;
    transition:
      transform var(--t-med) ease,
      opacity var(--t-med) ease;
  }

  @media (max-width: 900px) {
    .hd-toggle {
      display: flex;
    }

    .hd-inner {
      position: relative;
      z-index: 2;
    }

    /* full-screen menu, light like the rest of the site */
    .hd-links {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      background: var(--bg);
      padding: calc(var(--nav-h) + var(--s-5)) var(--gutter) var(--s-6);
      gap: 0;
      opacity: 0;
      transition:
        opacity 200ms ease,
        visibility 0s linear 200ms;
      overflow-y: auto;
      visibility: hidden;
    }

    .hd-links.open {
      opacity: 1;
      visibility: visible;
      transition: opacity 200ms ease;
    }

    .hd-links a:not(.hd-cta) {
      color: var(--ink-strong);
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--line);
    }

    .hd-links a.active::after {
      display: none;
    }

    .hd-links a.active {
      color: var(--accent-strong);
    }

    .hd-cta {
      margin-top: var(--s-6);
      height: 52px;
    }

    .hd.menu-open {
      background: var(--bg);
      border-bottom-color: var(--line);
    }

    .hd--dark.menu-open .brand,
    .hd--dark.menu-open .hd-toggle {
      color: var(--ink-strong);
    }

    .hd--dark .hd-links a:not(.hd-cta),
    .hd--dark .hd-links a:not(.hd-cta):hover {
      color: var(--ink-strong);
    }

    .hd--dark .hd-links a.active:not(.hd-cta) {
      color: var(--accent-strong);
    }

    .hd-toggle[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .hd-toggle[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }

    .hd-toggle[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<style is:global>
  body.nav-open {
    overflow: hidden;
  }
</style>

<script>
  const hd = document.getElementById('hd')!;
  const toggle = document.getElementById('hdToggle')!;
  const links = document.getElementById('hdLinks')!;

  const setOpen = (open: boolean) => {
    links.classList.toggle('open', open);
    hd.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.classList.toggle('nav-open', open);
  };

  toggle.addEventListener('click', () => setOpen(!links.classList.contains('open')));

  links.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && links.classList.contains('open')) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
