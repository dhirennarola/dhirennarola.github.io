---
/**
 * Before / after diagram for a case study: the separate tools the client
 * ran on, and the one Odoo system that replaced them. Everything shown
 * comes from the case study's own front matter.
 */
interface Props {
  before: string[];
  platform: string;
  modules: string[];
  integrations: string[];
}

const { before, platform, modules, integrations } = Astro.props;
const shown = modules.slice(0, 8);
const more = modules.length - shown.length;
---

<figure class="ba" aria-label="Before and after diagram">
  <div class="ba-side ba-before">
    <span class="label">Before</span>
    <ul>
      {before.map((b) => <li>{b}</li>)}
    </ul>
  </div>

  <div class="ba-arrow" aria-hidden="true">
    <svg viewBox="0 0 48 24" width="48" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h42"/><path d="m36 5 8 7-8 7"/></svg>
  </div>

  <div class="ba-side ba-after">
    <span class="label">After</span>
    <div class="ba-core">
      <span class="ba-platform">One {platform} system</span>
      <ul class="ba-mods">
        {shown.map((m) => <li>{m}</li>)}
        {more > 0 && <li class="ba-more">+{more} more</li>}
      </ul>
    </div>
    {integrations.length > 0 && (
      <p class="ba-int">
        <span class="label">Connected to</span>
        {integrations.join(' · ')}
      </p>
    )}
  </div>
</figure>

<style>
  .ba {
    margin: 0;
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  @media (min-width: 860px) {
    .ba {
      grid-template-columns: minmax(0, 5fr) 64px minmax(0, 7fr);
      gap: var(--s-4);
    }
  }

  .ba .label {
    display: flex;
    margin: 0 0 var(--s-3);
  }

  .ba-before ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
  }

  /* Separate tools: dashed boxes, slightly offset, nothing joining them */
  .ba-before li {
    margin: 0;
    padding: 0.7rem 0.85rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .ba-before li:nth-child(even) {
    transform: translateY(6px);
  }

  .ba-arrow {
    display: grid;
    place-items: center;
    color: var(--accent);
  }

  @media (max-width: 859px) {
    .ba-arrow svg {
      transform: rotate(90deg);
    }
  }

  /* The one system: logo navy, the way Odoo core is drawn across the site */
  .ba-core {
    background: var(--navy-900);
    border-radius: var(--radius);
    padding: var(--s-5);
  }

  .ba-platform {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #fff;
    margin-bottom: var(--s-4);
  }

  .ba-mods {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ba-mods li {
    margin: 0;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--navy-line);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--td);
  }

  .ba-mods .ba-more {
    color: var(--td-faint);
    border-style: dashed;
  }

  .ba-int {
    margin: var(--s-4) 0 0;
    font-size: var(--text-sm);
    color: var(--ink);
    border-left: 2px solid var(--accent);
    padding-left: var(--s-4);
  }

  .ba-int .label {
    margin-bottom: 0.15rem;
  }
</style>
